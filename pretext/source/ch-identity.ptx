																				[Gb, close={15, 24}]
																			]
																			[b{=}b, open]
																		]
																	]
																	[a{=}b]
																]
															]
														]
													]
													[d{=}b]
												]
											]
											]
											[\enot Ga
											[\enot \enot Gb, grouped, close={13, 14}
