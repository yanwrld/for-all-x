<tabular><col halign="right"/><col halign="center"/><col halign="left"/>
<row><cell><m>\extension{D}</m></cell><cell>=</cell><cell><m>\begin{array}{l|lllll}
Dxy        &amp; \mathbf{a} &amp; \mathbf{b} &amp; \mathbf{c} &amp; \mathbf{d} &amp; \mathbf{f} \\ \hline
\mathbf{a} &amp; -          &amp; 1          &amp; -          &amp; -          &amp; -          \\
\mathbf{b} &amp; -          &amp; -          &amp; -          &amp; -          &amp; -          \\
\mathbf{c} &amp; -          &amp; -          &amp; -          &amp; 1          &amp; 0          \\
\mathbf{d} &amp; -          &amp; -          &amp; -          &amp; -          &amp; 1          \\
\mathbf{f} &amp; -          &amp; -          &amp; -          &amp; -          &amp; -         
