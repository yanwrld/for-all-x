					[Gd, grouped
					[\enot Ge, grouped
								[c{=}a \eor c{=}b, checked, just=1 $\forall$
									[c{=}a, just=11 \eor, name=e2
										[Ga, just={=: e1, e2}
											[Ga, just=2 \eiff
