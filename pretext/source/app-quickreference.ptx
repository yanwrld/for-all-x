<title>Characteristic Truth Tables</title>
<sidebyside margins="0%" valign="top">
<tabular><col halign="center" right="minor"/><col halign="center"/>
<row bottom="minor"><cell><m>\metaA{}</m></cell><cell><m>\enot\metaA{}</m></cell></row>
<row><cell>1</cell><cell>0</cell></row>
<row><cell>0</cell><cell>1</cell></row></tabular>
<tabular><col halign="center" right="minor"/><col halign="center" right="minor"/><col halign="center" right="minor"/><col halign="center" right="minor"/><col halign="center" right="minor"/><col halign="center"/>
<row bottom="minor"><cell><m>\metaA{}</m></cell><cell><m>\metaB{}</m></cell><cell><m>\metaA{}\eand\metaB{}</m></cell><cell><m>\metaA{}\eor\metaB{}</m></cell><cell><m>\metaA{}\eif\metaB{}</m></cell><cell><m>\metaA{}\eiff\metaB{}</m></cell></row>
<row><cell>1</cell><cell>1</cell><cell>1</cell><cell>1</cell><cell>1</cell><cell>1</cell></row>
